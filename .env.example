# Copy to .env (or export directly) — only needed to run eval/run.py
# against a real model. The stub backend (default) needs none of this.

# --- ApiBackend (Anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenAICompatBackend (any OpenAI-chat-completions-shaped host:
# Groq, Together, Fireworks, DeepInfra, Ollama Cloud, etc.) ---
INSTINCT_EVAL_BASE_URL=
INSTINCT_EVAL_API_KEY=
INSTINCT_EVAL_MODEL=

# Never commit a real .env — it's already covered by .gitignore below,
# confirm that stays true if you rename this file.
